# Copy to cloud.env (never commit it) and run:  python cloud_sync.py --env-file cloud.env
# --- Microsoft sign-in: choose ONE mode --------------------------------------------------------------
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# A) app-only (work/school account, admin consent needed):
#MS_TENANT_ID=<directory (tenant) id>
#MS_CLIENT_SECRET=<client secret value>
#ONEDRIVE_USER=you@yourcompany.com
# B) signed in as you (personal or work/school): run  python login_device.py --client-id ... --out sync_run/token.json
#MS_TENANT_ID=common            # 'consumers' for a personal Microsoft account
#MS_REFRESH_TOKEN=<printed by login_device.py>
# --- where things are in OneDrive (paths relative to the drive root) -----------------------------------
ONEDRIVE_WORKBOOK_PATH=NOVUM/NOVUM_Hospitality_Hotels_with_Booking_Images.xlsx
# Folder that contains 'novum-hotels-images' (default: the folder of the workbook):
#ONEDRIVE_IMAGES_FOLDER=NOVUM
#ONEDRIVE_REPORTS_FOLDER=NOVUM/sync-reports
